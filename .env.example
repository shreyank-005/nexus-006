# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Mode configuration: "mock" (default for demo/offline SIH evaluation) or "production"
AI_MODE="mock"

# Supabase Auth and Database Connection
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Production Model & OCR Microservice API endpoints (leave blank when AI_MODE=mock)
OCR_API_URL="https://api.synapsescreen.gov.in/v1/ocr"
OCR_API_KEY="your-ocr-api-key"

DOCUMENT_VALIDATION_API_URL="https://api.synapsescreen.gov.in/v1/validate"
DOCUMENT_VALIDATION_API_KEY="your-validation-api-key"

TAMPERING_API_URL="https://api.synapsescreen.gov.in/v1/forensics"
TAMPERING_API_KEY="your-tampering-api-key"

FACE_VERIFICATION_API_URL="https://api.synapsescreen.gov.in/v1/face-verify"
FACE_VERIFICATION_API_KEY="your-face-verification-api-key"

RISK_ENGINE_API_URL="https://api.synapsescreen.gov.in/v1/risk-engine"
RISK_ENGINE_API_KEY="your-risk-engine-api-key"

